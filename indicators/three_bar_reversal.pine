//@version=5
indicator(title="3-Bar Reversal [MNQ/NQ]", shorttitle="3BR", overlay=true, max_labels_count=500, max_lines_count=500)

// Inputs
grp_filter = "Signal Filters"
min_ext = input.float(2.0, "Min Bar2 Extension (pts)", minval=0.0, step=0.25, group=grp_filter)
prox = input.float(20.0, "Key Level Proximity (pts)", minval=0.0, step=1.0, group=grp_filter)

grp_levels = "Key Levels"
show_pdh = input.bool(true, "Show Prior Day High/Low", group=grp_levels)
show_or = input.bool(true, "Show Opening Range H/L", group=grp_levels)
show_pdc = input.bool(true, "Show Prior Day Close", group=grp_levels)
show_wopen = input.bool(true, "Show Weekly Open", group=grp_levels)
or_minutes = input.int(15, "Opening Range Minutes", minval=5, maxval=60, step=5, group=grp_levels)

grp_tp = "Stop & Target"
stop_pts = input.float(40.0, "Stop (pts)", minval=1.0, step=0.25, group=grp_tp)
target_pts = input.float(60.0, "Target (pts)", minval=1.0, step=0.25, group=grp_tp)
show_levels = input.bool(true, "Draw Stop/Target Lines on Signal", group=grp_tp)

grp_session = "Session"
sess_start = input.session("0900-1150", "Trading Session (ET)", group=grp_session)

grp_alert = "Alerts"
alert_long = input.bool(true, "Alert on Long Signal", group=grp_alert)
alert_short = input.bool(true, "Alert on Short Signal", group=grp_alert)

// Session filter
in_session = not na(time(timeframe.period, sess_start, "America/New_York"))

// Key Levels
[pdh, pdl, pdc] = request.security(syminfo.tickerid, "1D", [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)
weekly_open = request.security(syminfo.tickerid, "W", open, lookahead=barmerge.lookahead_on)

// Opening Range
var float or_high = na
var float or_low = na
var bool or_done = false

new_day = dayofweek != dayofweek[1]

if new_day
    or_done := false

rth_minute = (hour(time, "America/New_York") - 9) * 60 + minute(time, "America/New_York") - 30

if rth_minute >= 0 and rth_minute < or_minutes and not or_done
    or_high := na(or_high) or new_day ? high : math.max(or_high, high)
    or_low := na(or_low) or new_day ? low : math.min(or_low, low)

if rth_minute >= or_minutes
    or_done := true

// Level proximity check
near_level(price) =>
    if prox <= 0.0
        true
    else
        (not na(pdh) and math.abs(price - pdh) <= prox) or (not na(pdl) and math.abs(price - pdl) <= prox) or (not na(pdc) and math.abs(price - pdc) <= prox) or (not na(or_high) and math.abs(price - or_high) <= prox) or (not na(or_low) and math.abs(price - or_low) <= prox) or (not na(weekly_open) and math.abs(price - weekly_open) <= prox)

// Three-Bar Reversal Pattern
b1_high = high[2]
b1_low = low[2]
b2_close = close[1]
b2_high = high[1]
b2_low = low[1]
b3_close = close

long_raw = b2_close < (b1_low - min_ext) and b3_close > b1_high
short_raw = b2_close > (b1_high + min_ext) and b3_close < b1_low

long_signal = long_raw and in_session and near_level(b2_low)
short_signal = short_raw and in_session and near_level(b2_high)

// Anticipation alerts — fire on bar2 close (5 min early warning)
// bar1 = 1 bar ago, bar2 = current bar just closed
anticipate_long = close < (high[1] - min_ext) and in_session and near_level(close)
anticipate_short = close > (low[1] + min_ext) and in_session and near_level(close)

// Entry / Stop / Target
stop_long = close - stop_pts
tgt_long = close + target_pts
stop_short = close + stop_pts
tgt_short = close - target_pts

// Signal arrows
plotshape(long_signal, title="Long Signal", style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 0), size=size.normal, text="LONG")
plotshape(short_signal, title="Short Signal", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.normal, text="SHORT")

// Stop/Target lines
if show_levels and long_signal
    line.new(bar_index, stop_long, bar_index + 10, stop_long, color=color.red, width=1, style=line.style_dashed)
    line.new(bar_index, tgt_long, bar_index + 10, tgt_long, color=color.green, width=1, style=line.style_dashed)

if show_levels and short_signal
    line.new(bar_index, stop_short, bar_index + 10, stop_short, color=color.red, width=1, style=line.style_dashed)
    line.new(bar_index, tgt_short, bar_index + 10, tgt_short, color=color.green, width=1, style=line.style_dashed)

// Key level lines
plot(show_pdh and not na(pdh) ? pdh : na, "PDH", color=color.new(color.orange, 40), linewidth=1, style=plot.style_linebr)
plot(show_pdh and not na(pdl) ? pdl : na, "PDL", color=color.new(color.orange, 40), linewidth=1, style=plot.style_linebr)
plot(show_pdc and not na(pdc) ? pdc : na, "PDC", color=color.new(color.yellow, 50), linewidth=1, style=plot.style_linebr)
plot(show_or and not na(or_high) ? or_high : na, "ORH", color=color.new(color.aqua, 40), linewidth=1, style=plot.style_linebr)
plot(show_or and not na(or_low) ? or_low : na, "ORL", color=color.new(color.aqua, 40), linewidth=1, style=plot.style_linebr)
plot(show_wopen and not na(weekly_open) ? weekly_open : na, "Weekly Open", color=color.new(color.purple, 40), linewidth=1, style=plot.style_linebr)

// Anticipation markers (small dots on bar2 close)
plotshape(anticipate_long, title="Anticipate Long", style=shape.circle, location=location.belowbar, color=color.new(color.lime, 50), size=size.tiny, text="?")
plotshape(anticipate_short, title="Anticipate Short", style=shape.circle, location=location.abovebar, color=color.new(color.red, 50), size=size.tiny, text="?")

// Alerts - confirmed (bot style, bar3 close)
alertcondition(long_signal and alert_long, title="3BR Long Signal CONFIRMED", message="3-Bar Reversal LONG CONFIRMED on {{ticker}} {{interval}} @ {{close}} | BOT entering Bar4 open | Stop -40pts | Target +60pts")
alertcondition(short_signal and alert_short, title="3BR Short Signal CONFIRMED", message="3-Bar Reversal SHORT CONFIRMED on {{ticker}} {{interval}} @ {{close}} | BOT entering Bar4 open | Stop -40pts | Target +60pts")

// Alerts - anticipation (manual style, bar2 close)
alertcondition(anticipate_long, title="3BR Long WATCH (bar2)", message="3-Bar Reversal WATCH LONG on {{ticker}} {{interval}} @ {{close}} | Bar2 extended DOWN - watch for bar3 to close ABOVE bar1 high to confirm | MANUAL entry on bar3 close")
alertcondition(anticipate_short, title="3BR Short WATCH (bar2)", message="3-Bar Reversal WATCH SHORT on {{ticker}} {{interval}} @ {{close}} | Bar2 extended UP - watch for bar3 to close BELOW bar1 low to confirm | MANUAL entry on bar3 close")
